+		if ((effected == null) || (effected.getEffectList() == null))
+		{
+			return;
+		}
+		
+		final Set<AbnormalType> stillBlocked = EnumSet.noneOf(AbnormalType.class);
+		for (BuffInfo info : effected.getEffectList().getEffects())
+		{
+			if ((info == null) || (info.getSkill() == null) || (info.getSkill() == skill))
+			{
+				continue;
+			}
+			for (AbstractEffect effect : info.getEffects())
+			{
+				if (effect instanceof BlockAbnormalSlot)
+				{
+					stillBlocked.addAll(((BlockAbnormalSlot) effect).getBlockAbnormalSlots());
+				}
+			}
+		}
+		
+		final Set<AbnormalType> toRemove = EnumSet.copyOf(_blockAbnormalSlots);
+		toRemove.removeAll(stillBlocked);
+		if (!toRemove.isEmpty())
+		{
