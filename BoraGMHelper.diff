+package custom.BoraGMHelper;
+
+import java.util.StringTokenizer;
+import java.util.concurrent.ScheduledFuture;
+
+import org.l2jmobius.commons.threads.ThreadPool;
+import org.l2jmobius.gameserver.cache.HtmCache;
+import org.l2jmobius.gameserver.data.xml.SkillData;
+import org.l2jmobius.gameserver.entity.Location;
+import org.l2jmobius.gameserver.entity.World;
+import org.l2jmobius.gameserver.entity.actor.Creature;
+import org.l2jmobius.gameserver.entity.actor.Npc;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.handler.AdminCommandHandler;
+import org.l2jmobius.gameserver.handler.IAdminCommandHandler;
+import org.l2jmobius.gameserver.mechanics.script.Script;
+import org.l2jmobius.gameserver.mechanics.skill.AbnormalType;
+import org.l2jmobius.gameserver.mechanics.skill.Skill;
+import org.l2jmobius.gameserver.mechanics.skill.SkillCastingType;
+import org.l2jmobius.gameserver.network.serverpackets.MagicSkillLaunched;
+import org.l2jmobius.gameserver.network.serverpackets.MagicSkillUse;
+import org.l2jmobius.gameserver.network.serverpackets.NpcHtmlMessage;
+
+/**
+ * Bora GM Helper Support NPC
+ * Official retail recreation based on European skill definitions.
+ * @author Notorion
+ */
+public class BoraGMHelper extends Script implements IAdminCommandHandler
+{
+	// NPC ID
+	private static final int BORA_NPC_ID = 34502;
+	
+	// Location: Giran Town Center (heading 32768 faces forward towards players)
+	private static final Location BORA_LOC = new Location(83093, 148623, -3400, 32768);
+	
+	// Configuration: message sent to player upon receiving buffs (retail official: false/disabled)
+	private static final boolean ENABLE_BUFF_MESSAGE = false;
+	
+	// Buff Skill IDs
+	private static final int FEVER_MELODY = 62084;
+	private static final int DRUMBEAT_OF_SERENITY = 62085;
+	private static final int FANTASIA_HARMONY = 62086;
+	private static final int NOBLESSE_BLESSING = 32788;
+	private static final int SANTIAGO_ROYAL_SOUP = 34413;
+	
+	private static final String[] ADMIN_COMMANDS =
+	{
+		"admin_bora",
+		"admin_bora_helper"
+	};
+	
+	// Runtime state
+	private static Npc _boraNpc = null;
+	private static int _buffTier = 3; // Default 8 hours (Lv 3)
+	private static long _despawnTime = 0; // Timestamp for despawn (0 = permanent until restart)
+	private static ScheduledFuture<?> _despawnTask = null;
+	
+	private BoraGMHelper()
+	{
+		// Only register first talk (do NOT register as quest start/talk to avoid quest sound and quest icon)
+		addFirstTalkId(BORA_NPC_ID);
+		
+		AdminCommandHandler.getInstance().registerHandler(this);
+	}
+	
+	@Override
+	public String onFirstTalk(Npc npc, Player player)
+	{
+		return "34502.htm";
+	}
+	
+	@Override
+	public String onEvent(String event, Npc npc, Player player)
+	{
+		if (player == null)
+		{
+			return null;
+		}
+		
+		switch (event)
+		{
+			case "page1":
+			{
+				return "34502.htm";
+			}
+			case "page2":
+			{
+				String html = getHtm(player, "34502-1.htm");
+				if (html != null)
+				{
+					html = html.replace("%buff_duration%", getBuffDurationString());
+				}
+				return html;
+			}
+			case "page3":
+			{
+				return "34502-2.htm";
+			}
+			case "give_buffs":
+			{
+				applyBuffs(npc, player);
+				
+				// Optional message for retail official accuracy (disabled by default)
+				if (ENABLE_BUFF_MESSAGE)
+				{
+					player.sendMessage("Bora: May the Master's Blessing accompany your journey, meow!");
+				}
+				return null;
+			}
+		}
+		
+		return null;
+	}
+	
+	private void applyBuffs(Npc npc, Player player)
+	{
+		final int tier = _buffTier;
+		
+		// Apply buffs to player according to retail rule
+		giveBoraBuffsToCreature(npc, player, tier);
+		
+		// Also apply to player's summons / pet if present
+		if (player.hasPet())
+		{
+			giveBoraBuffsToCreature(npc, player.getPet(), tier);
+		}
+		
+		if (!player.getServitors().isEmpty())
+		{
+			for (Creature servitor : player.getServitors().values())
+			{
+				giveBoraBuffsToCreature(npc, servitor, tier);
+			}
+		}
+		
+		// Visual effect on NPC casting and impact on player and surrounding viewers
+		if (npc != null)
+		{
+			npc.broadcastPacket(new MagicSkillUse(npc, player, FANTASIA_HARMONY, tier, 500, 0));
+			npc.broadcastPacket(new MagicSkillLaunched(npc, FANTASIA_HARMONY, tier, SkillCastingType.NORMAL, player));
+		}
+		player.sendPacket(new MagicSkillUse(npc, player, FANTASIA_HARMONY, tier, 500, 0));
+		player.sendPacket(new MagicSkillLaunched(npc, FANTASIA_HARMONY, tier, SkillCastingType.NORMAL, player));
+		player.sendPacket(new MagicSkillLaunched(player, FANTASIA_HARMONY, tier, SkillCastingType.NORMAL, player));
+		player.broadcastPacket(new MagicSkillLaunched(player, FANTASIA_HARMONY, tier, SkillCastingType.NORMAL, player));
+	}
+	
+	private boolean hasCelestialCocktail(Creature creature)
+	{
+		if ((creature == null) || (creature.getEffectList() == null))
+		{
+			return false;
+		}
+		
+		return creature.getEffectList().isAffectedBySkill(22928) // Heavenly / Celestial Cocktail
+			|| creature.getEffectList().isAffectedBySkill(23764)
+			|| creature.getEffectList().isAffectedBySkill(34082)
+			|| creature.getEffectList().isAffectedBySkill(34620)
+			|| creature.getEffectList().isAffectedBySkill(39760)
+			|| creature.getEffectList().isAffectedBySkill(46178);
+	}
+	
+	private void giveBoraBuffsToCreature(Npc npc, Creature creature, int tier)
+	{
+		if (creature == null)
+		{
+			return;
+		}
+		
+		if (hasCelestialCocktail(creature))
+		{
+			// Retail rule: Celestial Cocktail is preserved! Only Noblesse Blessing and Santiago's Royal Soup apply.
+			applySkill(npc, creature, NOBLESSE_BLESSING, 1);
+			applySkill(npc, creature, SANTIAGO_ROYAL_SOUP, tier);
+		}
+		else
+		{
+			// Retail rule: Special Cocktail and all existing buffs are removed and replaced with all 5 Bora buffs.
+			removeOldBuffs(creature);
+			applySkill(npc, creature, FEVER_MELODY, tier);
+			applySkill(npc, creature, DRUMBEAT_OF_SERENITY, tier);
+			applySkill(npc, creature, FANTASIA_HARMONY, tier);
+			applySkill(npc, creature, NOBLESSE_BLESSING, 1);
+			applySkill(npc, creature, SANTIAGO_ROYAL_SOUP, tier);
+		}
+	}
+	
+	private void removeOldBuffs(Creature creature)
+	{
+		if ((creature == null) || (creature.getEffectList() == null))
+		{
+			return;
+		}
+		
+		creature.getEffectList().stopEffects(info ->
+		{
+			final Skill skill = info.getSkill();
+			if (skill == null)
+			{
+				return false;
+			}
+			
+			// Never remove Bora's own skills
+			final int id = skill.getId();
+			if ((id == FEVER_MELODY) || (id == DRUMBEAT_OF_SERENITY) || (id == FANTASIA_HARMONY) || (id == NOBLESSE_BLESSING) || (id == SANTIAGO_ROYAL_SOUP))
+			{
+				return false;
+			}
+			
+			// Remove Special Cocktail / common cocktails (e.g. 39890, 39891, 39892)
+			final String name = skill.getName();
+			if ((name != null) && (name.contains("Special Cocktail") || name.contains("Fruit Cocktail")))
+			{
+				return true;
+			}
+			
+			// Remove melody / harmony / song / dance abnormal types
+			final AbnormalType abnormalType = skill.getAbnormalType();
+			if ((abnormalType == AbnormalType.BUFF_SPECIAL_ATTACK) || (abnormalType == AbnormalType.BUFF_SPECIAL_AURA) || (abnormalType == AbnormalType.BUFF_SPECIAL_CLASS) || (abnormalType == AbnormalType.BUFF_SPECIAL_MULTI) || (abnormalType == AbnormalType.DITTY) || (abnormalType == AbnormalType.ARMOR_ELEMENT_ALL) || (abnormalType == AbnormalType.MULTI_BUFF) || (abnormalType == AbnormalType.COCKTAIL))
+			{
+				return true;
+			}
+			
+			return false;
+		}, true, true);
+	}
+	
+	private void applySkill(Npc npc, Creature target, int skillId, int level)
+	{
+		final Skill skill = SkillData.getInstance().getSkill(skillId, level);
+		if (skill != null)
+		{
+			skill.applyEffects(npc, target);
+		}
+	}
+	
+	private String getBuffDurationString()
+	{
+		switch (_buffTier)
+		{
+			case 1:
+			{
+				return "60-min";
+			}
+			case 2:
+			{
+				return "4-hr";
+			}
+			case 3:
+			default:
+			{
+				return "8-hr";
+			}
+		}
+	}
+	
+	@Override
+	public boolean onCommand(String command, Player activeChar)
+	{
+		if (!activeChar.isGM())
+		{
+			return false;
+		}
+		
+		final StringTokenizer st = new StringTokenizer(command, " ");
+		st.nextToken(); // skip command name (admin_bora / admin_bora_helper)
+		final String action = st.hasMoreTokens() ? st.nextToken() : "menu";
+		
+		switch (action.toLowerCase())
+		{
+			case "spawn":
+			{
+				int hours = 0;
+				if (st.hasMoreTokens())
+				{
+					try
+					{
+						hours = Integer.parseInt(st.nextToken());
+					}
+					catch (NumberFormatException e)
+					{
+						hours = 0;
+					}
+				}
+				
+				spawnBora(hours, activeChar);
+				showAdminMenu(activeChar);
+				break;
+			}
+			case "despawn":
+			{
+				despawnBora();
+				activeChar.sendMessage("Bora GM Helper has been despawned.");
+				showAdminMenu(activeChar);
+				break;
+			}
+			case "tier":
+			{
+				if (st.hasMoreTokens())
+				{
+					try
+					{
+						final int tier = Integer.parseInt(st.nextToken());
+						_buffTier = Math.max(1, Math.min(3, tier));
+						activeChar.sendMessage("Bora buff tier set to Level " + _buffTier + " (" + getBuffDurationString() + ").");
+					}
+					catch (NumberFormatException e)
+					{
+						activeChar.sendMessage("Invalid tier: 1 (60-min), 2 (4-hr), or 3 (8-hr).");
+					}
+				}
+				showAdminMenu(activeChar);
+				break;
+			}
+			case "goto":
+			{
+				activeChar.teleToLocation(BORA_LOC);
+				activeChar.sendMessage("Teleported to Bora GM Helper location.");
+				showAdminMenu(activeChar);
+				break;
+			}
+			case "menu":
+			default:
+			{
+				showAdminMenu(activeChar);
+				break;
+			}
+		}
+		
+		return true;
+	}
+	
+	private synchronized void spawnBora(int hours, Player gm)
+	{
+		despawnBora();
+		
+		_boraNpc = addSpawn(BORA_NPC_ID, BORA_LOC.getX(), BORA_LOC.getY(), BORA_LOC.getZ(), BORA_LOC.getHeading(), false, 0);
+		
+		if (hours > 0)
+		{
+			final long despawnDelayMs = hours * 3600 * 1000L;
+			_despawnTime = System.currentTimeMillis() + despawnDelayMs;
+			_despawnTask = ThreadPool.schedule(() ->
+			{
+				despawnBora();
+			}, despawnDelayMs);
+		}
+		else
+		{
+			_despawnTime = 0;
+			_despawnTask = null;
+		}
+		
+		// Announcement in English to all online players
+		World.broadcastToAllOnlinePlayers("[Announcement] Support NPC Bora (GM Helper) has appeared in the center of Giran! Come get your buffs!", false);
+		
+		if (gm != null)
+		{
+			gm.sendMessage("Bora GM Helper has been spawned at Giran Center for " + (hours > 0 ? (hours + " hour(s).") : "permanent (until restart)."));
+		}
+	}
+	
+	private synchronized void despawnBora()
+	{
+		if (_despawnTask != null)
+		{
+			_despawnTask.cancel(false);
+			_despawnTask = null;
+		}
+		
+		_despawnTime = 0;
+		
+		if (_boraNpc != null)
+		{
+			_boraNpc.deleteMe();
+			_boraNpc = null;
+		}
+	}
+	
+	private void showAdminMenu(Player player)
+	{
+		String content = HtmCache.getInstance().getHtm(player, "data/html/admin/bora_helper.htm");
+		if (content == null)
+		{
+			player.sendMessage("Error: data/html/admin/bora_helper.htm not found!");
+			return;
+		}
+		
+		final boolean isSpawned = (_boraNpc != null) && !_boraNpc.isDecayed() && _boraNpc.isSpawned();
+		content = content.replace("%status%", isSpawned ? "Spawned (Online)" : "Not Spawned (Offline)");
+		content = content.replace("%status_color%", isSpawned ? "00FF00" : "FF0000");
+		
+		String durationLeft = "None";
+		if (isSpawned)
+		{
+			if (_despawnTime == 0)
+			{
+				durationLeft = "Permanent (Until Restart)";
+			}
+			else
+			{
+				final long remaining = _despawnTime - System.currentTimeMillis();
+				if (remaining > 0)
+				{
+					final long hours = remaining / 3600000;
+					final long minutes = (remaining % 3600000) / 60000;
+					durationLeft = hours + "h " + minutes + "m";
+				}
+				else
+				{
+					durationLeft = "Expiring...";
+				}
+			}
+		}
+		content = content.replace("%duration_left%", durationLeft);
+		
+		String tierDesc;
+		switch (_buffTier)
+		{
+			case 1:
+			{
+				tierDesc = "60 Minutes (Lv 1)";
+				break;
+			}
+			case 2:
+			{
+				tierDesc = "4 Hours (Lv 2)";
+				break;
+			}
+			case 3:
+			default:
+			{
+				tierDesc = "8 Hours (Lv 3 - Default)";
+				break;
+			}
+		}
+		content = content.replace("%buff_tier_desc%", tierDesc);
+		
+		final NpcHtmlMessage html = new NpcHtmlMessage(0, 1);
+		html.setHtml(content);
+		player.sendPacket(html);
+	}
+	
+	@Override
+	public String[] getCommandList()
+	{
+		return ADMIN_COMMANDS;
+	}
+	
+	public static void main(String[] args)
+	{
+		new BoraGMHelper();
+	}
+}
