+</tr>
+</table>
+<br1>
+Select Buffs Tier Delivered by Bora:<br1>
+<table width=270>
+<tr>
+<td><button value="60 min (Lv 1)" action="bypass -h admin_bora tier 1" width=85 height=22 back="L2UI_CT1.Button_DF_Down" fore="L2UI_CT1.Button_DF"></td>
+<td><button value="4 hours (Lv 2)" action="bypass -h admin_bora tier 2" width=85 height=22 back="L2UI_CT1.Button_DF_Down" fore="L2UI_CT1.Button_DF"></td>
+<td><button value="8 hours (Lv 3)" action="bypass -h admin_bora tier 3" width=85 height=22 back="L2UI_CT1.Button_DF_Down" fore="L2UI_CT1.Button_DF"></td>
+</tr>
+</table>
+</center>
+</body></html>
