+<tr>
+<td><button value="8 Hours" action="bypass -h admin_bora spawn 8" width=130 height=22 back="L2UI_CT1.Button_DF_Down" fore="L2UI_CT1.Button_DF"></td>
+<td><button value="12 Hours" action="bypass -h admin_bora spawn 12" width=130 height=22 back="L2UI_CT1.Button_DF_Down" fore="L2UI_CT1.Button_DF"></td>
+</tr>
+<tr>
+<td><button value="24 Hours" action="bypass -h admin_bora spawn 24" width=130 height=22 back="L2UI_CT1.Button_DF_Down" fore="L2UI_CT1.Button_DF"></td>
